<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_absence_refuse_wizard_form" model="ir.ui.view">
        <field name="name">insea.absence.refuse.wizard.form</field>
        <field name="model">insea.absence.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuser la demande">
                <group>
                    <field name="request_id"/>
                    <field name="employee_id"/>
                    <field name="reason" placeholder="Expliquez à l'employé la raison du refus..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmer le refus"
                            class="btn-danger" data-hotkey="q"/>
                    <button string="Annuler" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
