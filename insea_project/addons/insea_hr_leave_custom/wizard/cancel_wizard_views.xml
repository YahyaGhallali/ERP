<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_absence_cancel_wizard_form" model="ir.ui.view">
        <field name="name">insea.absence.cancel.wizard.form</field>
        <field name="model">insea.absence.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Annuler la demande">
                <group>
                    <field name="request_id"/>
                    <field name="employee_id"/>
                    <field name="reason" placeholder="Indiquez la raison de l'annulation..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmer l'annulation"
                            class="btn-warning" data-hotkey="q"/>
                    <button string="Fermer" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
